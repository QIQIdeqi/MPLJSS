extends SceneTree
# 使用项目 Evidence 内的独立档案，绝不读取或覆盖玩家 user:// 存档。
const PROFILE := preload("res://scripts/run/profile_store.gd")
const SERVICE := preload("res://scripts/alchemy/alchemy_service.gd")
const MANAGER := preload("res://scripts/run/run_manager.gd")
const RUN_CONFIG := preload("res://scripts/run/run_config.gd")
const OUTPUT := "res://Evidence/LevelEntry_20261124/save_test"
var checks := 0
var failures: Array[String] = []

func _init() -> void:
	call_deferred("run_checks")

func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures.append(message)

func run_checks() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUTPUT))
	var path := OUTPUT + "/profile_%d.cfg" % Time.get_ticks_usec()
	var empty := PROFILE.new()
	empty.setup(ConfigFile.new())
	check(empty.material_count("dew") == 0 and empty.ability_count("burst") == 0 and empty.tier_limit() == 2, "空档使用兼容默认值")
	var legacy := ConfigFile.new()
	legacy.set_value("village", "coins", 41)
	legacy.set_value("material_inventory", "fire_powder", 3)
	legacy.set_value("material_inventory", "dew", 3)
	legacy.set_value("ability_inventory", "burst", 2)
	var profile := PROFILE.new()
	profile.setup(legacy, path)
	check(profile.material_count("fire_powder") == 3 and profile.ability_count("burst") == 2, "旧格式库存读取")
	check(profile.save_profile(), "首次写盘")
	var service := SERVICE.new()
	service.setup(profile)
	var crafted := service.experiment(["dew", "fire_powder"])
	check(crafted.success, "工房正确配方成功")
	var disk := ConfigFile.new()
	check(PROFILE.load_save(disk, path) == OK, "重新读取独立存档")
	var reloaded := PROFILE.new()
	reloaded.setup(disk, path)
	check(reloaded.material_count("fire_powder") == 2 and reloaded.material_count("dew") == 2, "工房扣料已写盘")
	check(reloaded.ability_count("burst") == 3 and reloaded.recipe_state("recipe_burst") == PROFILE.RECIPE_STATE_FOUND, "能力和配方发现已写盘")
	check(int(disk.get_value("village", "coins", 0)) == 41, "保留其他存档区段")
	check(int(disk.get_value("profile", "schema_version", 0)) == 1, "保存格式版本")
	var config := RUN_CONFIG.new()
	check(config.selected_level_id == &"greyford_01", "旧档无关卡号时默认首关")
	var entry_id := config.begin_entry(&"greyford_01", &"burst")
	config.cancel_entry()
	check(config.selected_level_id == &"greyford_01" and config.selected_ability == &"burst", "取消保留准备草稿")
	check(reloaded.ability_count("burst") == 3, "准备及取消不扣能力")
	entry_id = config.begin_entry(&"greyford_01", &"burst")
	check(reloaded.commit_entry_ability("burst", "greyford_01", entry_id), "入场提交成功")
	check(reloaded.ability_count("burst") == 2, "入场扣一次能力")
	check(reloaded.commit_entry_ability("burst", "greyford_01", entry_id) and reloaded.ability_count("burst") == 2, "重复确认不再次扣除")
	check(not reloaded.commit_entry_ability("echo", "greyford_01", entry_id), "同一入场号不能换能力重用")
	check(PROFILE.load_save(disk, path) == OK and int(disk.get_value("ability_inventory", "burst", 0)) == 2, "入场消耗已写盘")
	check(not reloaded.commit_entry_ability("echo", "greyford_01", "no_stock") and reloaded.ability_count("echo") == 0, "无库存不能入场")
	check(reloaded.commit_entry_ability("initial", "greyford_01", "free_entry"), "基础能力免费入场")
	var before := reloaded.snapshot()
	reloaded.save_path = OUTPUT + "/missing_directory/progress.cfg"
	check(not reloaded.commit_entry_ability("burst", "greyford_01", "write_failure"), "入场写盘失败被阻止")
	check(reloaded.ability_count("burst") == 2 and reloaded.save.encode_to_text() == String(before.config), "入场写盘失败完整回滚")
	service.setup(reloaded)
	crafted = service.experiment(["fire_powder", "dew"])
	check(not crafted.success and String(crafted.error).contains("保存失败"), "工房写盘失败反馈")
	check(reloaded.material_count("fire_powder") == 2 and reloaded.ability_count("burst") == 2, "工房写盘失败不扣料不产出")
	var manager := MANAGER.new()
	manager.setup(reloaded)
	manager.start_run(config.new_run_id())
	manager.collect_material("fire_powder", 2)
	check(not manager.settle_run_materials("test") and manager.is_run_active(), "结算保存失败保留账本")
	check(reloaded.material_count("fire_powder") == 2 and not reloaded.has_settled(manager.run_id), "结算保存失败回滚永久库存和结算号")
	reloaded.save_path = path
	check(manager.settle_run_materials("test") and reloaded.material_count("fire_powder") == 4, "结算可重试成功")
	check(manager.settle_run_materials("test") and reloaded.material_count("fire_powder") == 4, "重复结算不重复入账")
	check(config.new_run_id() != config.new_run_id(), "运行号不会复用进程计时")
	config.set_handoff({"hp": 87, "ledger": {"dew": 3}})
	var handoff := config.take_handoff()
	check(handoff.hp == 87 and handoff.ledger.dew == 3 and config.take_handoff().is_empty(), "阶段交接只取一次且保留数据")
	check(FileAccess.file_exists(path + ".bak"), "保留上一份完整存档备份")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	check(PROFILE.load_save(disk, path) == OK and int(disk.get_value("village", "coins", 0)) == 41, "主档缺失可读取备份")
	check(FileAccess.file_exists(path), "备份恢复为可用主档")
	var future := ConfigFile.new()
	future.set_value("profile", "schema_version", 2)
	future.save(path + ".future")
	check(PROFILE.load_save(disk, path + ".future") == ERR_FILE_UNRECOGNIZED, "较新格式存档不被旧版本覆盖")
	config.free()
	var report := {"checks": checks, "failures": failures, "path": path, "player_save_touched": false}
	var output := FileAccess.open(OUTPUT + "/verification.json", FileAccess.WRITE)
	output.store_string(JSON.stringify(report, "\t"))
	output.close()
	print("ENTRY_PROFILE_SMOKE_%s %d checks" % ["PASS" if failures.is_empty() else "FAIL", checks])
	for failure in failures:
		print("FAILED: ", failure)
	quit(0 if failures.is_empty() else 1)
